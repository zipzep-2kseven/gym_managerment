# Multi-Gym Monorepo Root Environment Example

# Node Environment
NODE_ENV=development
PORT=4000

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password
POSTGRES_DB=multi_gym_db
POSTGRES_PORT=5432

# Database Connection URLs:
# 1. Connection URL for local host machine (e.g. running scripts or local API connecting to Docker PostgreSQL):
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public

# 2. Connection URL within Docker network (used automatically inside containers):
# DOCKER_DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=public

# Authentication / JWT Configuration
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false # Set to true in HTTPS production
