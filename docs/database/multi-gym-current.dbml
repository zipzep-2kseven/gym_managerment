  updated_at timestamptz(3) [not null, default: `now()`]

  indexes {
    gym_trainer_id [name: 'pt_social_links_trainer_idx']
  }

  checks {
    `((platform)::text = ANY ((ARRAY['FACEBOOK'::character varying, 'INSTAGRAM'::character varying, 'YOUTUBE'::character varying, 'TIKTOK'::character varying, 'WEBSITE'::character varying])::text[]))` [name: 'pt_social_links_platform_check']
    `(btrim(url) <> ''::text)` [name: 'pt_social_links_url_check']
  }

  Note: '''Bảng bổ sung trong migration 0001_gym_business_update.'''
}

//////////////////////////////////////////////////////
// PT_WORKING_SCHEDULES — ADDED IN MIGRATION 0001
//////////////////////////////////////////////////////

Table pt_working_schedules {
  schedule_id uuid [pk, not null, default: `gen_random_uuid()`]
  gym_trainer_id uuid [not null]
  day_of_week varchar(20) [not null]
  start_time time(0) [not null]
  end_time time(0) [not null]
  status varchar(20) [not null, default: `'ACTIVE'::character varying`]
  created_at timestamptz(3) [not null, default: `now()`]
  updated_at timestamptz(3) [not null, default: `now()`]

  indexes {
    (gym_trainer_id, day_of_week) [name: 'pt_working_schedules_trainer_day_idx']
  }

  checks {
    `((day_of_week)::text = ANY ((ARRAY['MONDAY'::character varying, 'TUESDAY'::character varying, 'WEDNESDAY'::character varying, 'THURSDAY'::character varying, 'FRIDAY'::character varying, 'SATURDAY'::character varying, 'SUNDAY'::character varying])::text[]))` [name: 'pt_working_schedules_day_check']
    `((status)::text = ANY ((ARRAY['ACTIVE'::character varying, 'INACTIVE'::character varying])::text[]))` [name: 'pt_working_schedules_status_check']
    `(end_time > start_time)` [name: 'pt_working_schedules_time_check']
  }

  Note: '''Bảng bổ sung trong migration 0001_gym_business_update.'''
}

//////////////////////////////////////////////////////
// GYM_REVIEWS — ADDED IN MIGRATION 0001
//////////////////////////////////////////////////////

Table gym_reviews {
  gym_review_id uuid [pk, not null, default: `gen_random_uuid()`]
  gym_id uuid [not null]
  user_id uuid [not null]
  rating integer [not null]
  comment text
  status varchar(20) [not null, default: `'VISIBLE'::character varying`]
  hidden_at timestamptz(3)
  hidden_by uuid
  hidden_reason text
  created_at timestamptz(3) [not null, default: `now()`]
  updated_at timestamptz(3) [not null, default: `now()`]

  indexes {
    hidden_by [name: 'gym_reviews_moderator_idx']
    (gym_id, status) [name: 'gym_reviews_target_status_idx']
    user_id [name: 'gym_reviews_user_idx']
  }

  checks {
    `((((status)::text = 'VISIBLE'::text) AND (hidden_at IS NULL) AND (hidden_by IS NULL) AND (hidden_reason IS NULL)) OR (((status)::text = 'HIDDEN'::text) AND (hidden_at IS NOT NULL) AND (hidden_by IS NOT NULL) AND (hidden_reason IS NOT NULL) AND (btrim(hidden_reason) <> ''::text)))` [name: 'gym_reviews_moderation_check']
    `((rating >= 1) AND (rating <= 5))` [name: 'gym_reviews_rating_check']
    `((status)::text = ANY ((ARRAY['VISIBLE'::character varying, 'HIDDEN'::character varying])::text[]))` [name: 'gym_reviews_status_check']
  }

  Note: '''Bảng bổ sung trong migration 0001_gym_business_update.

TRIGGER (định nghĩa hàm nằm trong migration):
CREATE TRIGGER gym_review_guard BEFORE INSERT OR DELETE OR UPDATE ON public.gym_reviews FOR EACH ROW EXECUTE FUNCTION protect_customer_review();

TRIGGER (định nghĩa hàm nằm trong migration):
CREATE TRIGGER gym_review_truncate_guard BEFORE TRUNCATE ON public.gym_reviews FOR EACH STATEMENT EXECUTE FUNCTION protect_customer_review();'''
}

