{
  "name": "@multi-gym/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:e2e": "node scripts/run-browser-checks.mjs",
    "test:gym-ui": "playwright test --config playwright.gym.config.ts",
    "test:gym-live": "playwright test --config playwright.gym-live.config.ts",
    "test:package-ui": "playwright test --config playwright.package.config.ts",
    "test:package-live": "playwright test --config playwright.package-live.config.ts",
    "test:payment-demo": "playwright test --config playwright.payment-demo.config.ts",
    "test:pt-workflow": "playwright test --config playwright.pt-workflow.config.ts",
    "test:customer-calendar": "playwright test --config playwright.customer-calendar.config.ts",
    "test:reports": "playwright test --config playwright.reports.config.ts",
    "test:consultation": "playwright test --config playwright.consultation.config.ts",
    "test:gallery": "playwright test --config playwright.gallery.config.ts",
    "test:trainer-profile": "playwright test --config playwright.trainer-profile.config.ts",
    "test:reviews": "playwright test --config playwright.reviews.config.ts",
    "test:review-moderation": "playwright test --config playwright.review-moderation.config.ts",
    "test:admin-users": "playwright test --config playwright.admin-users.config.ts",
    "test:security": "playwright test --config playwright.security.config.ts",
    "test:auth": "playwright test --config playwright.auth.config.ts",
    "test:manager-dashboard": "playwright test --config playwright.manager-dashboard.config.ts",
    "test:admin-dashboard": "playwright test --config playwright.admin-dashboard.config.ts",
    "test:pt-dashboard": "playwright test --config playwright.pt-dashboard.config.ts",
    "test:customer-dashboard": "playwright test --config playwright.customer-dashboard.config.ts",
    "test:qa02": "node scripts/run-browser-checks.mjs --rounds=2",
    "test:accessibility": "playwright test --config playwright.qa02.config.ts",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json"
  },
  "dependencies": {
    "@multi-gym/shared": "*",
    "@tanstack/react-query": "^5.104.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.6.2",
    "vite": "^5.4.6"
  }
}
