# Multi-Gym API Environment Configuration Example
PORT=4000
NODE_ENV=development

# Database Connection:
# When running API directly on host connecting to Docker PostgreSQL:
DATABASE_URL=postgresql://postgres:postgres_secure_password@localhost:5432/multi_gym_db?schema=public

# When running API inside Docker container (configured automatically by docker-compose):
# DATABASE_URL=postgresql://postgres:postgres_secure_password@postgres:5432/multi_gym_db?schema=public

# Simulated payments only; disabled unless explicitly set to demo (non-production).
PAYMENT_MODE=disabled

# Optional gallery demo directory; Docker uses a separate persistent volume.
# GALLERY_UPLOAD_DIR=data/gallery-images
