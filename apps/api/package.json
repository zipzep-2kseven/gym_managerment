{
  "name": "@multi-gym/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/database/seed.ts",
    "db:bootstrap:admin": "tsx src/database/bootstrap-admin.ts",
    "test:database": "tsx tests/database-business.test.ts && tsx tests/gym-lifecycle.integration.test.ts && tsx tests/gym-02.acceptance.test.ts && npm run test:packages && npm run test:payment-demo && npm run test:pt-workflow",
    "test:lifecycle": "tsx tests/gym-lifecycle.integration.test.ts",
    "test:gym02": "tsx tests/gym-02.acceptance.test.ts",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "test:packages": "tsx tests/package.integration.test.ts && tsx tests/package.acceptance.test.ts",
    "test:payment-demo": "tsx tests/payment-demo.integration.test.ts",
    "test:pt-workflow": "tsx tests/pt-workflow.integration.test.ts && tsx tests/pt-workflow.migration.test.ts",
    "test:gym-onboarding": "tsx tests/gym-onboarding.integration.test.ts",
    "test:reports": "tsx tests/report.integration.test.ts",
    "test:consultation": "tsx tests/consultation.integration.test.ts",
    "test:gallery": "tsx tests/gallery.integration.test.ts",
    "test:trainer-profile": "tsx tests/trainer-profile.integration.test.ts",
    "test:reviews": "tsx tests/review.integration.test.ts",
    "test:review-moderation": "tsx tests/review-moderation.integration.test.ts",
    "test:admin-users": "tsx tests/admin-user.integration.test.ts",
    "test:security": "tsx --test tests/security.test.ts tests/login-rate-limit.test.ts && NODE_ENV=test PAYMENT_MODE=demo tsx tests/security.integration.test.ts",
    "test:qa01": "npm run test:security && npm run test:database && npm run test:gym-onboarding && npm run test:reports && npm run test:consultation && npm run test:gallery && npm run test:trainer-profile && npm run test:reviews && npm run test:review-moderation && npm run test:admin-users"
  },
  "dependencies": {
    "@multi-gym/shared": "*",
    "@node-rs/argon2": "^2.2.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.16.5",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
